# ─── Servidor ────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes que pueden llamar a la API (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Número de proxies delante de la API (0 en local, 1 detrás de Nginx/Render/Railway)
TRUST_PROXY=0

# ─── Base de datos MySQL ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portfolio
DB_PASSWORD=portfolio_password
DB_NAME=portfolio

# ─── Anti-bots ───────────────────────────────────────────
# Envíos del formulario permitidos por IP cada 15 minutos
CONTACT_RATE_LIMIT_MAX=5
# Mensajes permitidos por correo electrónico en 24 horas
MAX_MESSAGES_PER_EMAIL_PER_DAY=3
# Tiempo mínimo (ms) para llenar el formulario; más rápido se considera bot
MIN_FORM_FILL_MS=3000
# (Opcional) Cloudflare Turnstile: clave SECRETA. Va junto con VITE_TURNSTILE_SITE_KEY del frontend.
TURNSTILE_SECRET_KEY=

# ─── Administración ──────────────────────────────────────
# Clave para consultar los mensajes (GET /api/contacts). Mínimo 24 caracteres.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# ─── Correo ──────────────────────────────────────────────
# URL pública del portafolio (se usa en los botones y enlaces de los correos)
SITE_URL=http://localhost:5173

# Sin SMTP_HOST los correos NO se envían: se guardan como HTML en .mail-previews/
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo de Gmail
#        SMTP_PASS=contraseña de aplicación de 16 letras (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Nombre que verá el cliente como remitente
MAIL_FROM_NAME=Oismer Sehuanes
# Tu bandeja: aquí llegan las notificaciones de nuevos mensajes
MAIL_TO=oismer3405@gmail.com
