# Dominio público definitivo del sitio (sin "/" al final).
# Se usa en canonical, Open Graph, datos estructurados, sitemap.xml y robots.txt
VITE_SITE_URL=https://www.oismersehuanes.com

# URL base de la API. En desarrollo deja "/api" (Vite la redirige al backend local).
# En producción, si el backend vive en otro dominio: https://api.tudominio.com/api
VITE_API_URL=/api

# (Solo desarrollo) A dónde redirige Vite las peticiones /api
DEV_API_PROXY_TARGET=http://localhost:4000

# (Opcional) Anti-bots con Cloudflare Turnstile: clave PÚBLICA del sitio.
# Debe ir junto con TURNSTILE_SECRET_KEY en el backend. Vacía = desactivado.
VITE_TURNSTILE_SITE_KEY=
