# Variables para docker compose (copia este archivo como .env)

# ─── MySQL del contenedor ────────────────────────────────
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=cambia-esta-contraseña
MYSQL_ROOT_PASSWORD=cambia-esta-contraseña-de-root

# ─── API ─────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# ─── Correo (vacío = vista previa, no se envía nada) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=oismer3405@gmail.com

# ─── Cloudflare Turnstile (opcional; las dos o ninguna) ──
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
